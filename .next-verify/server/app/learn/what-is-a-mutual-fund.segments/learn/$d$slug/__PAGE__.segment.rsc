4:["$","ul",null,{"className":"mt-5 space-y-3 pl-5 text-muted-foreground","children":[["$","li","Equity funds primarily invest in shares and can experience significant market volatility.",{"className":"list-disc pl-1 leading-7","children":"Equity funds primarily invest in shares and can experience significant market volatility."}],["$","li","Debt funds invest in fixed-income instruments and carry interest-rate and credit risks.",{"className":"list-disc pl-1 leading-7","children":"Debt funds invest in fixed-income instruments and carry interest-rate and credit risks."}],["$","li","Hybrid funds combine asset classes in different proportions.",{"className":"list-disc pl-1 leading-7","children":"Hybrid funds combine asset classes in different proportions."}],["$","li","Index funds and ETFs aim to track a specified market index, subject to tracking difference.",{"className":"list-disc pl-1 leading-7","children":"Index funds and ETFs aim to track a specified market index, subject to tracking difference."}]]}]
5:["$","section","Costs and risks",{"children":[["$","h2",null,{"className":"font-display text-2xl font-bold","children":"Costs and risks"}],[["$","p","Schemes charge expenses that are reflected in NAV. Other costs and taxes may apply depending on the scheme and transaction. Read the Scheme Information Document, Key Information Memorandum and current disclosures.",{"className":"mt-4 leading-8 text-muted-foreground","children":"Schemes charge expenses that are reflected in NAV. Other costs and taxes may apply depending on the scheme and transaction. Read the Scheme Information Document, Key Information Memorandum and current disclosures."}],["$","p","Mutual funds do not guarantee returns unless a guarantee is explicitly structured and disclosed. Market movements can cause losses, including loss of principal.",{"className":"mt-4 leading-8 text-muted-foreground","children":"Mutual funds do not guarantee returns unless a guarantee is explicitly structured and disclosed. Market movements can cause losses, including loss of principal."}]],"$undefined"]}]
